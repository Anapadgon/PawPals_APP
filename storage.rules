// PawPals Firebase Storage Security Rules
// Cópialo en Firebase Console ▸ Storage ▸ Reglas ▸ Publicar.
//
// Filosofía:
//  - Cualquier usuario autenticado puede VER las fotos (para feed Explorar/chat).
//  - Sólo el dueño puede escribir/borrar en su carpeta.
//  - Tope de 5 MB y tipo MIME imagen para evitar subidas abusivas.

rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    function estaAutenticado() { return request.auth != null; }
    function esPropio(uid) { return estaAutenticado() && request.auth.uid == uid; }
    function esImagenValida() {
      return request.resource.size < 5 * 1024 * 1024
          && request.resource.contentType.coincidencias('image/.*');
    }

    // Foto de perfil del usuario: usuarios/{uid}/perfil.jpg
    match /usuarios/{uid}/{nombreArchivo} {
      allow read: if estaAutenticado();
      allow write: if esPropio(uid) && esImagenValida();
      allow delete: if esPropio(uid);
    }

    // Foto del perro del usuario: perros/{uidDueno}/perro.jpg
    match /perros/{uidDueno}/{nombreArchivo} {
      allow read: if estaAutenticado();
      allow write: if esPropio(uidDueno) && esImagenValida();
      allow delete: if esPropio(uidDueno);
    }
  }
}
